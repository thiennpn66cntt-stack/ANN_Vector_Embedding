        "#  HÀM ĐÁNH GIÁ CHUNG\n",
        "def recall_at_k(result_ids, truth_ids, k=10):\n",
        "    values = []\n",
        "    for pred, truth in zip(result_ids, truth_ids):\n",
        "        values.append(len(set(map(int, pred[:k])) & set(map(int, truth[:k]))) / k)\n",
        "    return float(np.mean(values))\n",
        "\n",
        "def evaluate_method(name, search_fn, queries=query_embeddings, truth=ground_truth_ids, k=10):\n",
        "    # Đo nhiều lượt để giảm nhiễu do hệ thống; báo cáo trung vị.\n",
        "    runs = []\n",
        "    result = None\n",
        "    for _ in range(3):\n",
        "        t0 = time.perf_counter()\n",
        "        result = search_fn(queries, k)\n",
        "        runs.append((time.perf_counter() - t0) * 1000 / len(queries))\n",
        "    latency = float(np.median(runs))\n",
        "    rec = recall_at_k(result, truth, k)\n",
        "    return {'method': name, 'recall@10': rec, 'ms_per_query': latency,\n",
        "            'queries_per_second': 1000/latency if latency > 0 else np.nan}, result\n",
        "\n",
        "# Kiểm tra Brute Force phải đạt Recall@10 = 1.0 so với chính Ground Truth.\n",
        "bf_row, bf_ids = evaluate_method(\n",
        "    'Brute Force',\n",
        "    lambda q, k: exact_search(q, corpus_embeddings, k=k, batch_size=16)[0]\n",
        ")\n",
        "print(bf_row)"
