        "print(\"========== KIỂM TRA CHẤT LƯỢNG CORPUS ==========\")\n",
        "\n",
        "# 1. Kiểm tra câu quá ngắn\n",
        "short_sentences = df[\n",
        "    df[\"text\"].astype(str).str.split().str.len() < 8\n",
        "]\n",
        "print(\"Câu dưới 8 từ:\", len(short_sentences))\n",
        "\n",
        "# 2. Kiểm tra câu trùng lặp\n",
        "duplicate_count = df[\"text\"].astype(str).str.casefold().duplicated().sum()\n",
        "print(\"Số câu trùng lặp:\", duplicate_count)\n",
        "\n",
        "# 3. Kiểm tra câu có quá nhiều ký tự đặc biệt\n",
        "def special_ratio(text):\n",
        "    text = str(text)\n",
        "    if len(text) == 0:\n",
        "        return 1\n",
        "    special = sum(\n",
        "        not (c.isalnum() or c.isspace())\n",
        "        for c in text\n",
        "    )\n",
        "    return special / len(text)\n",
        "\n",
        "df[\"special_ratio\"] = df[\"text\"].apply(special_ratio)\n",
        "\n",
        "special_sentences = df[df[\"special_ratio\"] > 0.3]\n",
        "print(\"Câu có tỷ lệ ký tự đặc biệt trên 30%:\", len(special_sentences))\n",
        "\n",
        "# 4. Kiểm tra câu có từ bị lặp liên tiếp bất thường\n",
        "def has_repeated_words(text):\n",
        "    words = str(text).casefold().split()\n",
