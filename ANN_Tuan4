      "source": [
        "dataset = load_dataset('wikimedia/wikipedia', '20231101.vi', split='train', streaming=True)\n",
        "\n",
        "def split_vietnamese_sentences(text):\n",
        "    text = re.sub(r'\\s+', ' ', str(text)).strip()\n",
        "    parts = re.split(r'(?<=[.!?。])\\s+', text)\n",
        "    out = []\n",
        "    for s in parts:\n",
        "        s = s.strip(' \\\\t\\\\n-•')\n",
        "        words = s.split()\n",
        "        if 8 <= len(words) <= 60 and len(s) >= 40:\n",
        "            out.append(s)\n",
        "    return out\n",
        "\n",
        "sentences = []\n",
        "seen = set()\n",
        "for row in tqdm(dataset, desc='Đọc Wikipedia'):\n",
        "    article = row.get('text', '')\n",
        "    for sent in split_vietnamese_sentences(article):\n",
        "        key = sent.lower()\n",
        "        if key not in seen:\n",
        "            seen.add(key)\n",
        "            sentences.append(sent)\n",
        "        if len(sentences) >= N_CORPUS + N_QUERIES:\n",
        "            break\n",
        "    if len(sentences) >= N_CORPUS + N_QUERIES:\n",
        "        break\n",
        "\n",
        "if len(sentences) < N_CORPUS + N_QUERIES:\n",
        "    raise RuntimeError(\n",
        "        f'Chỉ thu được {len(sentences)} câu, cần {N_CORPUS + N_QUERIES}. '\n",
        "        'Hãy chạy lại cell hoặc đổi nguồn/tăng thời gian tải.'\n",
        "    )\n",
        "rng = np.random.default_rng(SEED)\n",
        "order = rng.permutation(len(sentences))\n",
        "sentences = [sentences[i] for i in order]\n",
        "\n",
        "corpus_texts = sentences[:N_CORPUS]\n",
        "query_texts = sentences[N_CORPUS:N_CORPUS + N_QUERIES]\n",
        "\n",
        "with open(DATA_DIR/'corpus_vi.txt', 'w', encoding='utf-8') as f:\n",
        "    f.write('\\n'.join(corpus_texts))\n",
        "with open(DATA_DIR/'queries_vi.txt', 'w', encoding='utf-8') as f:\n",
        "    f.write('\\n'.join(query_texts))\n",
