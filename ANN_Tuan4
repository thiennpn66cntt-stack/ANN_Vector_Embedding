      "source": [
        "#  LSH RANDOM HYPERPLANES\n",
        "class RandomHyperplaneLSH:\n",
        "    def __init__(self, n_bits=12, n_tables=4, seed=42):\n",
        "        self.n_bits = n_bits\n",
        "        self.n_tables = n_tables\n",
        "        self.seed = seed\n",
        "        self.planes = []\n",
        "        self.tables = []\n",
        "        self.codes = []\n",
        "\n",
        "    def _hash_codes(self, X, planes):\n",
        "        # planes shape is expected to be (n_bits, d)\n",
        "        signs = (X @ planes.T) >= 0\n",
        "        # Mã số nguyên từ chuỗi bit; n_bits mặc định <= bit_length an toàn.\n",
        "        weights = (1 << np.arange(self.n_bits, dtype=np.uint64))\n",
        "        return (signs.astype(np.uint64) * weights).sum(axis=1)\n",
        "\n",
        "    def fit(self, X):\n",
        "        rng = np.random.default_rng(self.seed)\n",
        "        self.planes, self.tables, self.codes = [], [], []\n",
        "        d = X.shape[1]\n",
        "        for _ in range(self.n_tables):\n",
        "            # Sửa đổi ở đây: tạo ma trận planes có kích thước (n_bits, d)\n",
        "            planes = rng.normal(size=(self.n_bits, d)).astype('float32')\n",
        "            codes = self._hash_codes(X, planes)\n",
        "            table = {}\n",
        "            for idx, code_value in enumerate(codes):\n",
        "                table.setdefault(int(code_value), []).append(idx)\n",
        "            self.planes.append(planes)\n",
        "            self.tables.append(table)\n",
        "            self.codes.append(codes)\n",
        "        return self\n",
        "\n",
        "    def _candidate_ids(self, q, min_candidates=100):\n",
        "        candidates = set()\n",
        "        for planes, table, codes in zip(self.planes, self.tables, self.codes):\n",
        "            code = int(self._hash_codes(q[None, :], planes)[0])\n",
        "            candidates.update(table.get(code, []))\n",
        "            # Mở rộng Hamming: lật từng bit cho đến khi đủ ứng viên.\n",
        "            if len(candidates) < min_candidates:\n",
        "                for bit in range(self.n_bits):\n",
        "                    neighbor_code = code ^ (1 << bit)\n",
        "                    candidates.update(table.get(neighbor_code, []))\n",
        "                    if len(candidates) >= min_candidates:\n",
        "                        break\n",
        "        return np.fromiter(candidates, dtype=np.int64) if candidates else np.array([], dtype=np.int64)\n",
        "\n",
        "    def search_one(self, q, k=10, min_candidates=100):\n",
        "        cand = self._candidate_ids(q, min_candidates)\n",
        "        if len(cand) == 0:\n",
        "            # Fallback an toàn; trường hợp này không còn là truy vấn ANN thuần.\n",
        "            cand = np.arange(len(corpus_embeddings))\n",
        "        scores = corpus_embeddings[cand] @ q\n",
        "        take = min(k, len(cand))\n",
        "        return cand[np.argpartition(-scores, take-1)[:take]][np.argsort(-scores[np.argpartition(-scores, take-1)[:take]])]\n",
        "\n",
        "    def search(self, Q, k=10, min_candidates=100):\n",
        "        out = []\n",
        "        for q in Q:\n",
        "            out.append(self.search_one(q, k, min_candidates))\n",
        "        return np.asarray(out, dtype=np.int64)\n",
        "\n",
        "# Chạy thí nghiệm nhiều cấu hình bit và bảng.\n",
        "lsh_rows = []\n",
        "lsh_objects = {}\n",
        "for bits in [8, 12, 16]:\n",
        "    for tables in [2, 4, 8]:\n",
        "        lsh = RandomHyperplaneLSH(n_bits=bits, n_tables=tables, seed=SEED).fit(corpus_embeddings)\n",
        "        fn = lambda Q, k, obj=lsh: obj.search(Q, k=k, min_candidates=100)\n",
        "        row, ids = evaluate_method(f'LSH bits={bits}, tables={tables}', fn)\n",
        "        row.update({'n_bits': bits, 'n_tables': tables})\n",
        "        lsh_rows.append(row)\n",
        "        lsh_objects[(bits, tables)] = lsh\n",
        "        np.save(RESULT_DIR/f'lsh_b{bits}_t{tables}_top10.npy', ids)\n",
        "\n",
        "lsh_df = pd.DataFrame(lsh_rows).sort_values(['n_bits','n_tables'])\n",
        "display(lsh_df)"
