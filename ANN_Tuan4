            "========== NỘI DUNG NSW.PY ==========\n",
            "import numpy as np\n",
            "from tqdm.auto import tqdm\n",
            "\n",
            "\n",
            "class SimpleNSW:\n",
            "    def __init__(self, M=12, build_candidates=1200, seed=42):\n",
            "        self.M = M\n",
            "        self.build_candidates = build_candidates\n",
            "        self.seed = seed\n",
            "        self.X = None\n",
            "        self.graph = None\n",
            "\n",
            "    def fit(self, X):\n",
            "        self.X = X\n",
            "        n, d = X.shape\n",
            "        rng = np.random.default_rng(self.seed)\n",
            "        self.graph = [[] for _ in range(n)]\n",
            "        # Để khả thi trên Colab, mỗi nút chỉ so sánh với một tập ứng viên ngẫu nhiên\n",
            "        # thay vì tính toàn bộ ma trận N x N. Đây là cách dựng NSW xấp xỉ.\n",
            "        # Thêm cạnh vòng (i-1, i+1) để tăng liên thông cơ bản.\n",
            "        pool_size = min(self.build_candidates, n)\n",
            "        for i in tqdm(range(n), desc=f'Build NSW M={self.M}'):\n",
            "            pool = rng.choice(n, size=pool_size, replace=False)\n",
            "            pool = pool[pool != i]\n",
            "            if len(pool) == 0:\n",
            "                continue\n",
            "            sims = X[pool] @ X[i]\n",
            "            take = min(self.M, len(pool))\n",
            "            best = np.argpartition(-sims, take-1)[:take]\n",
            "            nbrs = pool[best].tolist()\n",
            "            if i > 0:\n",
            "                nbrs.append(i-1)\n",
            "            if i < n-1:\n",
            "                nbrs.append(i+1)\n",
            "            self.graph[i] = list(dict.fromkeys(nbrs))\n",
            "        return self\n",
            "\n",
            "    def search_one(self, q, k=10, max_steps=100):\n",
            "        current = 0\n",
            "        current_score = float(self.X[current] @ q)\n",
            "        visited = {current}\n",
            "        for _ in range(max_steps):\n",
            "            neighbors = self.graph[current]\n",
            "            if not neighbors:\n",
            "                break\n",
            "            scores = self.X[neighbors] @ q\n",
            "            best_pos = int(np.argmax(scores))\n",
            "            if float(scores[best_pos]) <= current_score:\n",
