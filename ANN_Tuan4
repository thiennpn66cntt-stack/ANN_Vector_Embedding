        "# 9C. FAISS HNSW\n",
        "faiss_hnsw_rows = []\n",
        "for M in [16, 32]:\n",
        "    index_hnsw = faiss.IndexHNSWFlat(d, M, faiss.METRIC_INNER_PRODUCT)\n",
        "    index_hnsw.hnsw.efConstruction = 100\n",
        "    index_hnsw.add(corpus_embeddings)\n",
        "    for ef in [32, 64, 128, 256]:\n",
        "        index_hnsw.hnsw.efSearch = ef\n",
        "        t0 = time.perf_counter()\n",
        "        scores, ids = index_hnsw.search(query_embeddings, TOP_K)\n",
        "        latency = (time.perf_counter()-t0)*1000/len(query_embeddings)\n",
        "        row = {'method': f'FAISS HNSW M={M}, efSearch={ef}',\n",
        "               'recall@10': recall_at_k(ids, ground_truth_ids, TOP_K),\n",
        "               'ms_per_query': latency, 'queries_per_second': 1000/latency,\n",
        "               'M': M, 'efSearch': ef}\n",
        "        faiss_hnsw_rows.append(row)\n",
        "        np.save(RESULT_DIR/f'faiss_hnsw_M{M}_ef{ef}_top10.npy', ids)\n",
        "faiss_hnsw_df = pd.DataFrame(faiss_hnsw_rows)\n",
        "display(faiss_hnsw_df)"
