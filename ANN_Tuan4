      "cell_type": "code",
      "source": [
        "# 8A. NSW TỰ CÀI\n",
        "class SimpleNSW:\n",
        "    def __init__(self, M=12, build_candidates=1200, seed=42):\n",
        "        self.M = M\n",
        "        self.build_candidates = build_candidates\n",
        "        self.seed = seed\n",
        "        self.X = None\n",
        "        self.graph = None\n",
        "\n",
        "    def fit(self, X):\n",
        "        self.X = X\n",
        "        n, d = X.shape\n",
        "        rng = np.random.default_rng(self.seed)\n",
        "        self.graph = [[] for _ in range(n)]\n",
        "        # Để khả thi trên Colab, mỗi nút chỉ so sánh với một tập ứng viên ngẫu nhiên\n",
        "        # thay vì tính toàn bộ ma trận N x N. Đây là cách dựng NSW xấp xỉ.\n",
        "        # Thêm cạnh vòng (i-1, i+1) để tăng liên thông cơ bản.\n",
        "        pool_size = min(self.build_candidates, n)\n",
        "        for i in tqdm(range(n), desc=f'Build NSW M={self.M}'):\n",
        "            pool = rng.choice(n, size=pool_size, replace=False)\n",
        "            pool = pool[pool != i]\n",
        "            if len(pool) == 0:\n",
        "                continue\n",
        "            sims = X[pool] @ X[i]\n",
        "            take = min(self.M, len(pool))\n",
        "            best = np.argpartition(-sims, take-1)[:take]\n",
        "            nbrs = pool[best].tolist()\n",
        "            if i > 0:\n",
        "                nbrs.append(i-1)\n",
        "            if i < n-1:\n",
        "                nbrs.append(i+1)\n",
        "            self.graph[i] = list(dict.fromkeys(nbrs))\n",
        "        return self\n",
        "\n",
        "    def search_one(self, q, k=10, max_steps=100):\n",
        "        current = 0\n",
        "        current_score = float(self.X[current] @ q)\n",
        "        visited = {current}\n",
        "        for _ in range(max_steps):\n",
        "            neighbors = self.graph[current]\n",
        "            if not neighbors:\n",
        "                break\n",
        "            scores = self.X[neighbors] @ q\n",
        "            best_pos = int(np.argmax(scores))\n",
        "            if float(scores[best_pos]) <= current_score:\n",
        "                break\n",
        "            current = int(neighbors[best_pos])\n",
        "            current_score = float(scores[best_pos])\n",
        "            visited.add(current)\n",
        "        candidates = set(visited)\n",
        "        candidates.update(self.graph[current])\n",
        "        cand = np.fromiter(candidates, dtype=np.int64)\n",
        "        scores = self.X[cand] @ q\n",
        "        take = min(k, len(cand))\n",
        "        loc = np.argpartition(-scores, take-1)[:take]\n",
        "        loc = loc[np.argsort(-scores[loc])]\n",
        "        result = cand[loc]\n",
        "        if len(result) < k:\n",
        "            result = np.pad(result, (0, k-len(result)), constant_values=0)\n",
        "        return result[:k]\n",
        "\n",
        "    def search(self, Q, k=10):\n",
        "        return np.asarray([self.search_one(q, k) for q in Q], dtype=np.int64)\n",
        "\n",
        "# Bản NSW tự cài dùng dựng đồ thị xấp xỉ để giảm chi phí trên Colab.\n",
        "# Tăng build_candidates có thể cải thiện chất lượng đồ thị nhưng tốn thời gian hơn.\n",
        "nsw_rows = []\n",
        "nsw_models = {}\n",
        "for M in [8, 12, 20]:\n",
        "    nsw = SimpleNSW(M=M, build_candidates=1200, seed=SEED).fit(corpus_embeddings)\n",
        "    nsw_models[M] = nsw\n",
        "    row, ids = evaluate_method(f'NSW M={M}', lambda Q, k, obj=nsw: obj.search(Q, k))\n",
        "    row.update({'M': M})\n",
        "    nsw_rows.append(row)\n",
        "    np.save(RESULT_DIR/f'nsw_M{M}_top10.npy', ids)\n",
        "\n",
        "nsw_df = pd.DataFrame(nsw_rows)\n",
        "display(nsw_df)"
