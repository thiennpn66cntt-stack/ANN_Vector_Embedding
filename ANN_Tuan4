        "        )\n",
        "\n",
        "        if torch.cuda.is_available():\n",
        "            q_t = q_t.to('cuda')\n",
        "\n",
        "        scores = q_t @ db_t.T\n",
        "\n",
        "        vals, ids = torch.topk(\n",
        "            scores,\n",
        "            k=k,\n",
        "            dim=1,\n",
        "            largest=True,\n",
        "            sorted=True\n",
        "        )\n",
        "\n",
        "        all_ids.append(ids.cpu().numpy())\n",
