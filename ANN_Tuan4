      "cell_type": "code",
      "source": [
        "def exact_search(query_vecs, database_vecs, k=10, batch_size=32):\n",
        "    db_t = torch.from_numpy(database_vecs)\n",
        "    if torch.cuda.is_available():\n",
        "        db_t = db_t.to('cuda')\n",
        "    all_ids = []\n",
        "    all_scores = []\n",
        "    for start in range(0, len(query_vecs), batch_size):\n",
        "        q_t = torch.from_numpy(query_vecs[start:start+batch_size])\n",
        "        if torch.cuda.is_available():\n",
        "            q_t = q_t.to('cuda')\n",
        "        scores = q_t @ db_t.T\n",
        "        vals, ids = torch.topk(scores, k=k, dim=1, largest=True, sorted=True)\n",
        "        all_ids.append(ids.cpu().numpy())\n",
        "        all_scores.append(vals.cpu().numpy())\n",
        "    return np.vstack(all_ids), np.vstack(all_scores)\n",
        "\n",
        "t0 = time.perf_counter()\n",
        "ground_truth_ids, ground_truth_scores = exact_search(\n",
        "    query_embeddings, corpus_embeddings, k=TOP_K, batch_size=16\n",
        ")\n",
        "exact_total_seconds = time.perf_counter() - t0\n",
        "exact_ms_per_query = exact_total_seconds / len(query_embeddings) * 1000\n",
        "\n",
        "np.save(RESULT_DIR/'ground_truth_top10.npy', ground_truth_ids)\n",
        "np.save(RESULT_DIR/'ground_truth_scores.npy', ground_truth_scores)\n",
        "print(\"Ground Truth:\", ground_truth_ids.shape)\n",
        "print(\"Brute Force tổng (s):\", round(exact_total_seconds, 3))\n",
        "print(\"Brute Force trung bình (ms/query):\", round(exact_ms_per_query, 3))"
      ],
